# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
BASE_URL=https://tu-dominio.railway.app

# ─── Base de datos ──────────────────────────────────────────────────────────────
# CRÍTICO: Siempre apuntar a /data/ (volumen Railway) para persistencia
DB_PATH=/data/jokin_tools.db

# ─── Email (SMTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password
EMAIL_FROM="Re-memory <tu-email@gmail.com>"
# Re-memory es por usuario: cada uno recibe sus recordatorios en el email de SU
# cuenta de login. EMAIL_TO solo se usa como destinatario de reserva si algún
# recordatorio no tuviera email de usuario asociado.
EMAIL_TO=destinatario@gmail.com

# Re-memory: a qué cuenta se asignan las palabras antiguas (sin dueño) al migrar.
# Si se deja vacío, se usan las de ADMIN_EMAIL. Solo aplica una vez, en el arranque.
REMEMORY_OWNER_EMAIL=

# ─── Dropbox ────────────────────────────────────────────────────────────────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FOLDER=/JokinTools/ReMemory/exports/

# ─── Backups automáticos ────────────────────────────────────────────────────────
# Carpeta Dropbox donde se guardan los backups de la base de datos
DROPBOX_BACKUP_FOLDER=/JokinTools/ReMemory/backups

# Intervalo entre backups automáticos, en horas (solo si hay cambios)
# Variable: BACKUP_INTERVAL_HOURS | Valor por defecto: 2
BACKUP_INTERVAL_HOURS=2

# Número máximo de backups a conservar (se borran los más antiguos al superar el límite)
# Variable: BACKUP_MAX_COUNT | Valor por defecto: 100
BACKUP_MAX_COUNT=100

# ─── Seguridad ──────────────────────────────────────────────────────────────────
# Token HMAC para links de desactivación en emails
# Genera uno aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEACTIVATION_SECRET=una-clave-aleatoria-segura

# ─── Login / cuentas (hub) ──────────────────────────────────────────────────────
# Administrador inicial. Al arrancar, el servidor crea (o actualiza) esta cuenta
# como admin con esta contraseña. Imprescindible para poder entrar la primera vez.
# La contraseña debe tener al menos 8 caracteres y NO vive en el código ni en git.
ADMIN_EMAIL=tu-email@dominio.com
ADMIN_PASSWORD=cambia-esta-contrasena-larga
# Duración de la sesión iniciada, en días. Default: 7
AUTH_SESSION_DAYS=7

# ─── AI Assistants (Re-memory) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ─── Imprimir (email → impresora) ──────────────────────────────────────────────
# Envía un email con un PDF adjunto al buzón de abajo y se imprime solo en la
# impresora física, mediante un agente local (carpeta print-agent/).
# Actívalo poniendo IMPRIMIR_ENABLED=true y configurando el buzón IMAP.
IMPRIMIR_ENABLED=false
# Buzón que recibe los correos a imprimir (IMAP; Gmail/Workspace → contraseña de aplicación)
IMPRIMIR_IMAP_HOST=imap.gmail.com
IMPRIMIR_IMAP_PORT=993
IMPRIMIR_IMAP_SECURE=true
IMPRIMIR_IMAP_USER=imprimir@joaquincastilla.com
IMPRIMIR_IMAP_PASS=contrasena-de-aplicacion
IMPRIMIR_IMAP_MAILBOX=INBOX
# Quién puede mandar a imprimir (lista separada por comas). Vacío = nadie imprime.
IMPRIMIR_ALLOWLIST=castilla@joaquincastilla.com
# Poner a true SOLO si quieres que cualquiera que escriba al buzón pueda imprimir.
IMPRIMIR_ALLOW_ALL=false
# Nombre de la impresora de destino (ruta de red de Windows).
IMPRIMIR_DEFAULT_PRINTER=\\cicpri042\Color
# Clave compartida con el agente local (print-agent/config.json → api_key).
# Genera una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMPRIMIR_AGENT_KEY=
# Opcionales:
# IMPRIMIR_DIR=/data/imprimir            (dónde se guardan los PDF en el servidor)
# IMPRIMIR_MAX_MB=25                     (tamaño máximo por adjunto)
# IMPRIMIR_POLL_CRON=* * * * *           (frecuencia del sondeo del buzón)
# IMPRIMIR_RETENTION_DAYS=14             (días que se conservan los trabajos ya hechos)
# IMPRIMIR_NOTIFY_RECEIVED=true          (acuse de recibo al remitente: "recibido, en cola")
# IMPRIMIR_NOTIFY_NO_PDF=true            (avisar si su correo no traía nada imprimible)
# Formatos aceptados: PDF, imágenes (JPG/PNG) y Word (DOCX). El servidor los
# convierte a PDF (DOCX vía LibreOffice, ya incluido en nixpacks.toml).
# Los emails (acuse de recibo + confirmación de impresión) reutilizan el SMTP de arriba.

# ─── Batchwork ─────────────────────────────────────────────────────────────────
# Límite de subida por lote (MB). Default: 500
BATCHWORK_MAX_UPLOAD_MB=500
# Directorio temporal para sesiones de Batchwork
BATCHWORK_TMP_DIR=/tmp/batchwork
# TTL de sesión en minutos. Default: 30
BATCHWORK_SESSION_TTL_MIN=30
